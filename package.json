{
  "name": "dsh-systemd-restart",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin: a restart row in Settings -> General for hosts supervised by systemd. The host exits gracefully and the unit's Restart=always brings it back, so no detached helper, no cgroup escape and no privileges are needed.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "restart",
    "systemd",
    "settings"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-host-webserver": ">=0.2.0-rc.1"
  },
  "scripts": {
    "test": "node test/smoke.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.1",
      "dshReleases": {
        "0.2.1-rc.2": "compatible"
      }
    }
  }
}
